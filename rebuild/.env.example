# Nouveau runtime uniquement. Ne pas copier les credentials legacy.
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=
DJANGO_SITE_ORIGIN=
LIONSMED_DB_PURPOSE=
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=
# Optionnel, défaut : test_<DB_NAME>, toujours dans le nouveau cluster.
DB_TEST_NAME=
# SMTP désactivé par défaut ; local/test n'envoient jamais de vrai mail.
LIONSMED_SMTP_ENABLED=
EMAIL_HOST=
EMAIL_PORT=
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=

LIONSMED_CONTACT_RECIPIENT=
LIONSMED_PUBLIC_INDEXING=

# Scanner antivirus des documents privés (clamd). Renseigner l'un ou l'autre.
# Sans configuration, aucun document ne peut devenir disponible (échec fermé voulu).
LIONSMED_CLAMD_SOCKET=
LIONSMED_CLAMD_HOST=
LIONSMED_CLAMD_PORT=

# Heure de référence (HH:MM, Africa/Tunis) pour l'ouverture/fermeture de la satisfaction
# mensuelle. Non définie tant que le club ne l'a pas confirmée ; aucune période ne
# s'active sans elle.
LIONSMED_SATISFACTION_HOUR=
