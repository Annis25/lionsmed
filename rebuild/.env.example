# Nouveau runtime uniquement. Ne pas copier les credentials legacy.
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=
DJANGO_SITE_ORIGIN=
LIONSMED_DB_PURPOSE=
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=
# Optionnel, défaut : test_<DB_NAME>, toujours dans le nouveau cluster.
DB_TEST_NAME=
# SMTP désactivé par défaut ; local/test n'envoient jamais de vrai mail.
LIONSMED_SMTP_ENABLED=
EMAIL_HOST=
EMAIL_PORT=
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=

LIONSMED_CONTACT_RECIPIENT=
LIONSMED_PUBLIC_INDEXING=

# Scanner antivirus des documents privés (clamd). Renseigner l'un ou l'autre.
# Sans configuration, aucun document ne peut devenir disponible (échec fermé voulu).
LIONSMED_CLAMD_SOCKET=
LIONSMED_CLAMD_HOST=
LIONSMED_CLAMD_PORT=

# Boîtes e-mail institutionnelles (Messagerie). Serveur commun aux dix boîtes ; les valeurs
# par défaut (mail.lionsmed.tn, IMAP 993, SMTP 465, SSL/TLS) conviennent sans rien renseigner.
LIONSMED_MAILBOX_HOST=
LIONSMED_MAILBOX_IMAP_PORT=
LIONSMED_MAILBOX_SMTP_PORT=
# Un mot de passe par boîte. Une boîte laissée vide reste inactive dans Lionsmed.
# Ne jamais inscrire de vraie valeur ici ni dans le dépôt : uniquement dans le .env du serveur.
LIONSMED_MAILBOX_PASSWORD_PRESIDENT=
LIONSMED_MAILBOX_PASSWORD_VICE_PRESIDENT=
LIONSMED_MAILBOX_PASSWORD_SECRETARIAT=
LIONSMED_MAILBOX_PASSWORD_TRESORIER=
LIONSMED_MAILBOX_PASSWORD_PRESIDENT_FONDATEUR=
LIONSMED_MAILBOX_PASSWORD_DIRECTEUR=
LIONSMED_MAILBOX_PASSWORD_GMT=
LIONSMED_MAILBOX_PASSWORD_GST=
LIONSMED_MAILBOX_PASSWORD_LCIF=
LIONSMED_MAILBOX_PASSWORD_MARKETING_COMMUNICATION=
