# Modèle de configuration — copier en .env et renseigner les valeurs.
# Ne jamais versionner le .env réel (déjà couvert par .gitignore).

# ── Général ───────────────────────────────────────────────────────────────────
# DEBUG doit rester à False en production. Absent = False (défaut sûr).
DEBUG=False

# Obligatoire : l'application refuse de démarrer sans cette variable.
# Générer avec :
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=

# ── Email ─────────────────────────────────────────────────────────────────────
# Hors DEBUG, le backend console est interdit (il écrirait les mots de passe
# temporaires dans les journaux du serveur). EMAIL_HOST est obligatoire.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_TIMEOUT=10
DEFAULT_FROM_EMAIL=secretariat@lionsmed.tn
