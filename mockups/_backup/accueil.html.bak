<!DOCTYPE html>
<html lang="fr" class="scroll-smooth">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>Maquette — Accueil | Lions Sfax Med</title>

<!--
  ═══════════════════════════════════════════════════════════════════════════
  MAQUETTE STATIQUE — NE FAIT PAS PARTIE DE L'APPLICATION DJANGO
  ═══════════════════════════════════════════════════════════════════════════
  Fichier autonome, ouvrable directement dans un navigateur.
  Aucune dépendance au projet : ni template, ni vue, ni base de données.
  Toutes les données affichées sont fictives et servent uniquement à
  illustrer la mise en page pour validation par le bureau du club.

  ─── NOM DU CLUB — À CONFIRMER ───────────────────────────────────────────
  Le nom définitif n'est pas arrêté. Il est centralisé dans la constante
  CLUB_NAME, tout en bas de ce fichier (bloc <script>), et injecté partout
  où il apparaît (titre du hero, logo, pied de page, onglet du navigateur).
  Pour l'essayer : changer cette seule ligne et recharger la page.
  ─────────────────────────────────────────────────────────────────────────
-->

<script src="https://cdn.tailwindcss.com"></script>
<script>
  /* Configuration reprise telle quelle de templates/base.html
     pour garantir une palette et des polices strictement identiques. */
  tailwind.config = {
    theme: {
      extend: {
        colors: {
          navy: {
            50:'#EEF2F8',100:'#D5DFF0',200:'#ABBFE0',300:'#7F9FCF',400:'#557FBE',
            500:'#2B5FAD',600:'#1E4B8E',700:'#163870',800:'#0E2550',900:'#0B1F3A',950:'#060F1D',
          },
          gold: {
            50:'#FBF6EC',100:'#F5EAD1',200:'#EBD4A3',300:'#E0BE74',400:'#D6A849',
            500:'#C9A84C',600:'#A8862A',700:'#7D641F',800:'#534215',900:'#29210A',
          },
          ivory: '#F8F6F0',

          /* ── Couleurs relevées au pixel près sur logomed.png ──
             lions #184898 = 63 % des pixels du logo (bleu de marque)
             sun   #F8C800 = 33 % des pixels du logo (jaune de marque)
             Ce sont désormais les couleurs primaires de la page ; navy et
             gold sont conservés pour les fonds sombres et les nuances. */
          lions: {
            50:'#F1F4F9',100:'#DCE4F0',200:'#B5C4DE',300:'#87A0C9',400:'#4F74B1',
            500:'#184898',600:'#153E83',700:'#11326A',800:'#0D2752',900:'#091B3A',950:'#061124',
          },
          sun: {
            50:'#FFFCF0',100:'#FEF7D9',200:'#FDEDAD',300:'#FBE27A',400:'#FAD53D',
            500:'#F8C800',600:'#D5AC00',700:'#AE8C00',800:'#866C00',900:'#5E4C00',
          },
        },
        fontFamily: {
          sans:  ['Inter', 'system-ui', 'sans-serif'],
          serif: ['"Playfair Display"', 'Georgia', 'serif'],
        },
      },
    },
  }
</script>

<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Inter:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400&family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400&display=swap" rel="stylesheet" />

<style>
  /* ── Cadre bleu marine tout autour de la page ── */
  body {
    border: 3px solid #184898;
    min-height: 100vh;
  }

  /* ── Révélation au défilement (repris de static/css/main.css) ── */
  .reveal {
    opacity: 0;
    transform: translateY(24px);
    transition: opacity .7s cubic-bezier(.16,1,.3,1), transform .7s cubic-bezier(.16,1,.3,1);
  }
  .reveal.visible { opacity: 1; transform: translateY(0); }
  .reveal:nth-child(2) { transition-delay: .08s; }
  .reveal:nth-child(3) { transition-delay: .16s; }
  .reveal:nth-child(4) { transition-delay: .24s; }
  .reveal:nth-child(5) { transition-delay: .32s; }
  .reveal:nth-child(6) { transition-delay: .40s; }

  .card-hover { transition: transform .25s ease, box-shadow .25s ease, border-color .25s ease; }
  .card-hover:hover { transform: translateY(-4px); box-shadow: 0 18px 40px -18px rgba(11,31,58,.28); }

  /* ── Indicateur de défilement ── */
  @keyframes scroll-pulse {
    0%,100% { opacity: .25; transform: scaleY(.7); }
    50%     { opacity: .8;  transform: scaleY(1); }
  }
  .scroll-line { animation: scroll-pulse 2.2s ease-in-out infinite; transform-origin: top; }

  /* ── Accessibilité : focus visible ── */
  a:focus-visible, button:focus-visible {
    outline: 2px solid #C9A84C;
    outline-offset: 3px;
    border-radius: 4px;
  }

  /* ── Respect de la préférence « animations réduites » ── */
  @media (prefers-reduced-motion: reduce) {
    .reveal { opacity: 1; transform: none; transition: none; }
    .scroll-line { animation: none; }
    html { scroll-behavior: auto; }
  }
</style>
</head>

<!-- ══════════════════════════════════════════════════════════════════════
     NAVBAR — fixe, fond blanc, séparateur bas fin
     ══════════════════════════════════════════════════════════════════════ -->
<header class="fixed top-0 left-0 right-0 z-50 bg-white border-b border-lions-100">
  <div class="max-w-[1400px] mx-auto px-6 lg:px-10">
    <div class="flex items-center justify-between h-[76px] gap-6">

      <!-- Logo officiel du club -->
      <a href="accueil.html" class="relative text-[15px] font-semibold text-sun-600 pb-1 after:absolute after:left-0 after:-bottom-0.5 after:h-[2px] after:w-full after:bg-sun-600" aria-label="Lions Sfax Med — accueil">
        <img src="logomed.png" alt="Lions Sfax Med"
             class="h-[52px] w-auto" width="1006" height="557" />
      </a>

      <!-- Menu principal -->
      <nav class="hidden lg:flex items-center gap-8" aria-label="Navigation principale">
        <a href="accueil.html" class="relative text-[15px] font-semibold text-sun-600 pb-1 after:absolute after:left-0 after:-bottom-0.5 after:h-[2px] after:w-full after:bg-sun-600"
           aria-current="page">Accueil</a>
        <a href="notre-club.html" class="text-[15px] font-medium text-lions-600 hover:text-sun-600 transition-colors">Notre Club</a>
        <a href="nos-actions.html" class="text-[15px] font-medium text-lions-600 hover:text-sun-600 transition-colors">Nos Actions</a>
        <a href="evenements.html" class="text-[15px] font-medium text-lions-600 hover:text-sun-600 transition-colors">Événements</a>
        <a href="actualites.html" class="text-[15px] font-medium text-lions-600 hover:text-sun-600 transition-colors">Actualités</a>
        <a href="rejoindre.html" class="text-[15px] font-medium text-lions-600 hover:text-sun-600 transition-colors">Rejoindre</a>
        <a href="contact.html" class="text-[15px] font-medium text-lions-600 hover:text-sun-600 transition-colors">Contact</a>
      </nav>

      <!-- Cloche + pastille utilisateur -->
      <div class="flex items-center gap-4 flex-shrink-0">
        <button type="button" class="relative text-lions-500 hover:text-sun-600 transition-colors p-1"
                aria-label="Notifications (3 non lues)">
          <svg class="w-[22px] h-[22px]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.7">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 17h5l-1.4-1.4A2 2 0 0118 14.2V11a6 6 0 00-4-5.7V5a2 2 0 10-4 0v.3C7.7 6.2 6 8.4 6 11v3.2c0 .5-.2 1-.6 1.4L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"/>
          </svg>
          <span class="absolute top-0.5 right-0.5 w-2 h-2 rounded-full bg-sun-500 ring-2 ring-white"></span>
        </button>

        <a href="connexion.html" class="inline-flex items-center gap-2 pl-3.5 pr-4 py-2 rounded-full
                           bg-sun-500 hover:bg-sun-400 text-lions-800 text-sm font-semibold
                           transition-colors">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
          </svg>
          Fatma
        </a>

        <!-- Bouton menu mobile -->
        <button type="button" id="menu-btn"
                class="lg:hidden text-lions-700 p-1" aria-label="Ouvrir le menu" aria-expanded="false">
          <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" d="M4 7h16M4 12h16M4 17h16"/>
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Menu mobile -->
  <div id="mobile-menu" class="lg:hidden hidden border-t border-lions-100 bg-white">
    <nav class="px-6 py-4 flex flex-col gap-1" aria-label="Navigation mobile">
      <a href="accueil.html" class="relative text-[15px] font-semibold text-sun-600 pb-1 after:absolute after:left-0 after:-bottom-0.5 after:h-[2px] after:w-full after:bg-sun-600">Accueil</a>
      <a href="notre-club.html" class="text-[15px] font-medium text-lions-600 hover:text-sun-600 transition-colors">Notre Club</a>
      <a href="nos-actions.html" class="text-[15px] font-medium text-lions-600 hover:text-sun-600 transition-colors">Nos Actions</a>
      <a href="evenements.html" class="text-[15px] font-medium text-lions-600 hover:text-sun-600 transition-colors">Événements</a>
      <a href="actualites.html" class="text-[15px] font-medium text-lions-600 hover:text-sun-600 transition-colors">Actualités</a>
      <a href="rejoindre.html" class="text-[15px] font-medium text-lions-600 hover:text-sun-600 transition-colors">Rejoindre</a>
      <a href="contact.html" class="text-[15px] font-medium text-lions-600 hover:text-sun-600 transition-colors">Contact</a>
    </nav>
  </div>
</header>

<!-- ══════════════════════════════════════════════════════════════════════
     HERO — plein écran, fond très clair, décor arcs + lion en filigrane
     ══════════════════════════════════════════════════════════════════════ -->
<section id="accueil"
         class="relative min-h-screen flex items-center justify-center overflow-hidden
                bg-gradient-to-b from-lions-50 via-[#F6F9FD] to-white pt-[84px]">

  <!-- Emblème officiel en filigrane, à droite -->
  <div class="absolute right-0 top-1/2 -translate-y-1/2 translate-x-[18%] pointer-events-none select-none
              w-[560px] max-w-[55vw] opacity-[0.06]" aria-hidden="true">
    <img src="emblem.png" alt="" class="w-full h-auto" />
  </div>

  <!-- Arcs concentriques en bas à gauche -->
  <div class="absolute -bottom-40 -left-40 w-[540px] h-[540px] pointer-events-none select-none"
       aria-hidden="true">
    <svg viewBox="0 0 200 200" fill="none" class="w-full h-full">
      <circle cx="0" cy="200" r="188" stroke="#184898" stroke-width="17" opacity=".95"/>
      <circle cx="0" cy="200" r="164" stroke="#F8C800" stroke-width="15"/>
      <circle cx="0" cy="200" r="140" stroke="#184898" stroke-width="20"/>
    </svg>
  </div>

  <!-- Contenu -->
  <div class="relative z-10 w-full max-w-4xl mx-auto px-6 text-center py-20">

    <!-- Badge district -->
    <div class="reveal inline-flex items-center gap-2.5 px-5 py-2 mb-9
                border border-sun-500 rounded-full bg-white/80 backdrop-blur-sm">
      <svg class="w-3.5 h-3.5 text-sun-600 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
        <path fill-rule="evenodd" d="M10 18s6-5.7 6-10A6 6 0 004 8c0 4.3 6 10 6 10zm0-8a2 2 0 110-4 2 2 0 010 4z" clip-rule="evenodd"/>
      </svg>
      <span class="text-[11px] font-bold tracking-[0.16em] text-lions-600 uppercase">
        Lions Clubs International — District 414 B Tunisie
      </span>
      <span class="w-1.5 h-1.5 rounded-full bg-sun-500 flex-shrink-0" aria-hidden="true"></span>
    </div>

    <!-- Titre principal -->
    <h1 class="reveal font-serif font-bold leading-[1.05] mb-6">
      <span class="block text-lions-500 text-[clamp(2.75rem,8vw,5.5rem)]">Lions Club</span>
      <span class="block text-sun-500 text-[clamp(2.25rem,6.5vw,4.5rem)] mt-1" data-club-name>Sfax Med</span>
    </h1>

    <!-- Devise -->
    <p class="reveal font-serif italic text-lions-500 text-[clamp(1rem,2.2vw,1.4rem)] mb-8">
      « We Serve — Servir, c'est notre raison d'être »
    </p>

    <!-- Paragraphe descriptif -->
    <p class="reveal text-lions-800/75 text-[17px] leading-[1.75] max-w-[700px] mx-auto mb-11">
      Fondé en 2025, notre club réunit des femmes et des hommes engagés pour servir
      Sfax avec constance, dans un esprit de proximité, d'écoute et d'action utile
      au bénéfice des communautés les plus vulnérables.
    </p>

    <!-- Boutons d'action -->
    <div class="reveal flex flex-col sm:flex-row items-center justify-center gap-4">
      <a href="nos-actions.html"
         class="group inline-flex items-center justify-center gap-2.5 w-full sm:w-auto
                px-8 py-4 rounded-lg bg-sun-500 hover:bg-sun-400
                text-lions-800 text-[15px] font-bold
                shadow-lg shadow-sun-500/30 transition-all duration-200 hover:-translate-y-0.5">
        Découvrir nos actions
        <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none"
             viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
        </svg>
      </a>
      <a href="rejoindre.html"
         class="inline-flex items-center justify-center w-full sm:w-auto
                px-8 py-4 rounded-lg border-2 border-lions-500 hover:bg-lions-500
                text-lions-600 hover:text-white text-[15px] font-bold
                transition-all duration-200 hover:-translate-y-0.5">
        Rejoindre le club
      </a>
    </div>
  </div>

  <!-- Indicateur de défilement -->
  <a href="#stats" class="absolute bottom-10 left-1/2 -translate-x-1/2 z-10 flex flex-col items-center gap-3
                          text-lions-500 hover:text-sun-600 transition-colors">
    <span class="text-[10px] font-bold tracking-[0.28em] uppercase">Défiler</span>
    <span class="scroll-line block w-px h-12 bg-gradient-to-b from-lions-400 to-transparent"></span>
  </a>
</section>
<!-- ══════════════════════════════════════════════════════════════════════
     CHIFFRES CLÉS
     ══════════════════════════════════════════════════════════════════════ -->
<section id="stats" class="relative bg-lions-800 py-16 overflow-hidden">
  <div class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-sun-500/60 to-transparent"></div>

  <div class="max-w-6xl mx-auto px-6">
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-y-10 gap-x-8">
      <div class="reveal text-center">
        <div class="font-serif text-5xl font-bold text-sun-500 mb-2">2025</div>
        <div class="text-white/50 text-[11px] font-semibold uppercase tracking-[0.2em]">Année de fondation</div>
        <div class="w-8 h-0.5 bg-sun-500/40 mx-auto mt-3"></div>
      </div>
      <div class="reveal text-center">
        <div class="font-serif text-5xl font-bold text-sun-500 mb-2">45</div>
        <div class="text-white/50 text-[11px] font-semibold uppercase tracking-[0.2em]">Membres</div>
        <div class="w-8 h-0.5 bg-sun-500/40 mx-auto mt-3"></div>
      </div>
      <div class="reveal text-center">
        <div class="font-serif text-5xl font-bold text-sun-500 mb-2">12</div>
        <div class="text-white/50 text-[11px] font-semibold uppercase tracking-[0.2em]">Projets</div>
        <div class="w-8 h-0.5 bg-sun-500/40 mx-auto mt-3"></div>
      </div>
      <div class="reveal text-center">
        <div class="font-serif text-5xl font-bold text-sun-500 mb-2">500<span class="text-3xl text-sun-500/60">+</span></div>
        <div class="text-white/50 text-[11px] font-semibold uppercase tracking-[0.2em]">Bénéficiaires</div>
        <div class="w-8 h-0.5 bg-sun-500/40 mx-auto mt-3"></div>
      </div>
    </div>
  </div>

  <div class="absolute inset-x-0 bottom-0 h-px bg-gradient-to-r from-transparent via-sun-500/60 to-transparent"></div>
</section>
<!-- ══════════════════════════════════════════════════════════════════════
     NOTRE CLUB
     ══════════════════════════════════════════════════════════════════════ -->
<section id="notre-club" class="py-24 bg-white">
  <div class="max-w-6xl mx-auto px-6">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-14 lg:gap-20 items-center">

      <div class="reveal">
        <div class="flex items-center gap-3 mb-5">
          <span class="w-9 h-px bg-sun-500"></span>
          <span class="text-sun-700 text-[11px] font-bold uppercase tracking-[0.2em]">Notre identité</span>
        </div>

        <h2 class="font-serif text-[clamp(2rem,4vw,3rem)] font-bold text-lions-700 leading-[1.15] mb-7">
          Une vision de service,<br>
          <span class="text-sun-600">une mission de proximité</span>
        </h2>

        <p class="text-lions-700/70 text-[17px] leading-[1.8] mb-5">
          Fondé en 2025 à Sfax, le <span data-club-full>Lions Sfax Med</span> rassemble des
          membres fondateurs animés par une même volonté : servir utilement la ville,
          ses quartiers et ses initiatives citoyennes.
        </p>
        <p class="text-lions-700/55 text-[15px] leading-[1.8] mb-10">
          Nos membres sont des professionnels, entrepreneurs, médecins, enseignants
          et citoyens engagés qui mettent leur temps, leurs compétences et leur réseau
          au service d'actions locales utiles et mesurables.
        </p>

        <!-- Valeurs -->
        <ul class="space-y-5 mb-10">
          <li class="flex items-start gap-4">
            <span class="w-11 h-11 rounded-xl bg-lions-50 border border-lions-100 flex items-center justify-center flex-shrink-0">
              <svg class="w-5 h-5 text-lions-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.9" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M4.3 6.3a4.5 4.5 0 000 6.4L12 20.4l7.7-7.7a4.5 4.5 0 00-6.4-6.4L12 7.6l-1.3-1.3a4.5 4.5 0 00-6.4 0z"/>
              </svg>
            </span>
            <div>
              <h3 class="font-semibold text-lions-700 text-[15px] mb-1">Service</h3>
              <p class="text-lions-700/55 text-[13.5px] leading-relaxed">
                Le service aux autres est au centre de tout ce que nous faisons.
              </p>
            </div>
          </li>
          <li class="flex items-start gap-4">
            <span class="w-11 h-11 rounded-xl bg-sun-50 border border-sun-200 flex items-center justify-center flex-shrink-0">
              <svg class="w-5 h-5 text-sun-700" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.9" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.6-4a12 12 0 01-8.6 3 12 12 0 01-8.6 3A12 12 0 003 9c0 5.6 3.8 10.3 9 11.6 5.2-1.3 9-6 9-11.6 0-1-.1-2-.4-3z"/>
              </svg>
            </span>
            <div>
              <h3 class="font-semibold text-lions-700 text-[15px] mb-1">Intégrité</h3>
              <p class="text-lions-700/55 text-[13.5px] leading-relaxed">
                Transparence totale dans la gestion des fonds et la gouvernance du club.
              </p>
            </div>
          </li>
          <li class="flex items-start gap-4">
            <span class="w-11 h-11 rounded-xl bg-lions-50 border border-lions-100 flex items-center justify-center flex-shrink-0">
              <svg class="w-5 h-5 text-lions-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.9" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M17 20h5v-2a3 3 0 00-5.4-1.9M17 20H7m10 0v-2c0-.7-.1-1.3-.4-1.9M7 20H2v-2a3 3 0 015.4-1.9M7 20v-2c0-.7.1-1.3.4-1.9m0 0a5 5 0 019.2 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/>
              </svg>
            </span>
            <div>
              <h3 class="font-semibold text-lions-700 text-[15px] mb-1">Amitié</h3>
              <p class="text-lions-700/55 text-[13.5px] leading-relaxed">
                Des liens sincères qui vont bien au-delà de l'association.
              </p>
            </div>
          </li>
        </ul>

        <a href="nos-actions.html"
           class="inline-flex items-center gap-2 text-lions-600 hover:text-sun-700 font-bold text-[15px]
                  border-b-2 border-sun-500 hover:border-sun-600 pb-1 transition-colors">
          Voir nos actions concrètes
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
          </svg>
        </a>
      </div>

      <!-- Emplacement photo -->
      <div class="reveal relative">
        <div class="absolute -top-5 -right-5 w-full h-full rounded-2xl border-2 border-sun-200" aria-hidden="true"></div>
        <div class="relative rounded-2xl overflow-hidden bg-lions-50 border border-lions-100 aspect-[4/5]">
          <div class="absolute inset-0 flex flex-col items-center justify-center text-lions-300 p-8">
            <svg class="w-20 h-20 mb-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4 16l4.6-4.6a2 2 0 012.8 0L16 16m-2-2l1.6-1.6a2 2 0 012.8 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/>
            </svg>
            <p class="text-sm text-center font-medium">Photo du club<br>à fournir</p>
          </div>

          <div class="absolute bottom-5 left-5 right-5 bg-white/90 backdrop-blur-sm rounded-xl px-4 py-3
