      <!-- Santé & Diabète -->
      <article class="reveal card-hover bg-white rounded-2xl p-8 border border-lions-100">
        <span class="w-[52px] h-[52px] rounded-xl bg-red-50 flex items-center justify-center mb-6">
          <svg class="w-6 h-6 text-red-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.9" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4.3 6.3a4.5 4.5 0 000 6.4L12 20.4l7.7-7.7a4.5 4.5 0 00-6.4-6.4L12 7.6l-1.3-1.3a4.5 4.5 0 00-6.4 0z"/>
          </svg>
        </span>
        <h3 class="font-serif text-xl font-bold text-lions-700 mb-3">Santé &amp; Diabète</h3>
        <p class="text-lions-700/55 text-[14px] leading-[1.75] mb-6">
          Sensibilisation au diabète, dépistages de proximité et relais vers les
