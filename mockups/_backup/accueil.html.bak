        </span>
      </article>

      <!-- Environnement -->
      <article class="reveal card-hover bg-white rounded-2xl p-8 border border-lions-100">
        <span class="w-[52px] h-[52px] rounded-xl bg-green-50 flex items-center justify-center mb-6">
          <svg class="w-6 h-6 text-green-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.9" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 11h2a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v3M8 4v1.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1M15 20.5V18a2 2 0 012-2h3"/>
