      <!-- Éducation & Jeunesse -->
      <article class="reveal card-hover bg-white rounded-2xl p-8 border border-lions-100">
        <span class="w-[52px] h-[52px] rounded-xl bg-sun-50 flex items-center justify-center mb-6">
          <svg class="w-6 h-6 text-sun-700" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.9" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 14l9-5-9-5-9 5 9 5zm0 0l6.2-3.4a12 12 0 01.6 6.5A12 12 0 0012 20a12 12 0 00-6.8-3 12 12 0 01.6-6.5L12 14z"/>
          </svg>
        </span>
        <h3 class="font-serif text-xl font-bold text-lions-700 mb-3">Éducation &amp; Jeunesse</h3>
        <p class="text-lions-700/55 text-[14px] leading-[1.75] mb-6">
          Soutien à la jeunesse, accompagnement scolaire et initiatives éducatives
