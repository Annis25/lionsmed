<script>
<script>
/* ═══════════════════════════════════════════════════════════════════════
   NOM DU CLUB
   ═══════════════════════════════════════════════════════════════════════
   Le logo officiel (logomed.png) porte la mention « Lions Sfax Med » :
   c'est donc ce nom qui est repris ici. Il reste centralisé dans ces deux
   constantes, injectées partout où le nom apparaît (titre du hero, pied de
   page, onglet du navigateur). Modifier ces lignes suffit à tout changer. */

const CLUB_NAME  = 'Sfax Med';   // titre jaune du hero — repris du logo officiel
const CLUB_SHORT = 'SFAX MED';   // variantes en petites capitales

/* ─── Injection (ne rien modifier en dessous) ─────────────────────────── */
document.querySelectorAll('[data-club-name]').forEach(el => {
  el.textContent = CLUB_NAME;
});
document.querySelectorAll('[data-club-short]').forEach(el => {
  el.textContent = CLUB_SHORT;
});
document.querySelectorAll('[data-club-full]').forEach(el => {
  el.textContent = el.textContent.replace(/Lions Sfax Med/g, 'Lions Club ' + CLUB_NAME);
});
document.title = 'Maquette — Accueil | Lions ' + CLUB_NAME;


/* ═══════════════════════════════════════════════════════════════════════
   INTERACTIONS
   ═══════════════════════════════════════════════════════════════════════ */

/* 1 — Menu mobile */
const menuBtn = document.getElementById('menu-btn');
const mobileMenu = document.getElementById('mobile-menu');
if (menuBtn && mobileMenu) {
  menuBtn.addEventListener('click', () => {
    const ouvert = !mobileMenu.classList.contains('hidden');
    mobileMenu.classList.toggle('hidden');
    menuBtn.setAttribute('aria-expanded', String(!ouvert));
  });
  mobileMenu.querySelectorAll('a').forEach(lien => {
    lien.addEventListener('click', () => {
      mobileMenu.classList.add('hidden');
      menuBtn.setAttribute('aria-expanded', 'false');
    });
  });
}

/* 2 — Révélation progressive au défilement */
const aReveler = document.querySelectorAll('.reveal');
if ('IntersectionObserver' in window) {
  const observateur = new IntersectionObserver((entrees) => {
    entrees.forEach(entree => {
      if (entree.isIntersecting) {
        entree.target.classList.add('visible');
        observateur.unobserve(entree.target);
      }
    });
  }, { threshold: 0.12, rootMargin: '0px 0px -60px 0px' });
  aReveler.forEach(el => observateur.observe(el));
} else {
  aReveler.forEach(el => el.classList.add('visible'));
}

</script>

</body>
</html>
